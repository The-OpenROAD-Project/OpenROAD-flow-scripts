                values ("0.013, 0.013")
            }
            fall_power(spsram_256x32_h_energy_template_sigslew) {
                index_1 ("0.009, 0.227");
                values ("0.013, 0.013")
            }
        }
    }
    bus(wd_in)   {
        bus_type : spsram_256x32_h_DATA;
        memory_write() {
            address : addr_in;
            clocked_on : "clk";
        }
        direction : input;
        capacitance : 0.005000;
        timing() {
            related_pin : clk;
            timing_type : setup_rising ;
            rise_constraint(spsram_256x32_h_constraint_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.009, 0.227");
                values ( \
                  "0.050, 0.050", \
