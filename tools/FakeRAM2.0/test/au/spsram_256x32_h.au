            rise_power(spsram_256x32_h_energy_template_sigslew) {
                index_1 ("0.009, 0.227");
                values ("0.013, 0.013")
            }
            fall_power(spsram_256x32_h_energy_template_sigslew) {
                index_1 ("0.009, 0.227");
                values ("0.013, 0.013")
            }
        }
        internal_power(){
            when : "(we_in)";
            rise_power(spsram_256x32_h_energy_template_sigslew) {
                index_1 ("0.009, 0.227");
                values ("0.013, 0.013")
            }
            fall_power(spsram_256x32_h_energy_template_sigslew) {
                index_1 ("0.009, 0.227");
                values ("0.013, 0.013")
            }
        }
    }
    cell_leakage_power : 128.900;
