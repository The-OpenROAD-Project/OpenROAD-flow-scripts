            }
        }
    }
    bus(wd_in)   {
        bus_type : spsram_256x256_DATA;
        memory_write() {
            address : addr_in;
            clocked_on : "clk";
        }
        direction : input;
        capacitance : 0.005000;
        timing() {
            related_pin : clk;
            timing_type : setup_rising ;
            rise_constraint(spsram_256x256_constraint_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.009, 0.227");
