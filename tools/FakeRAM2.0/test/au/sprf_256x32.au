    input  wire                     we_a;
    input  wire [ADDR_WIDTH-1:0]    addr_a;
    input  wire [DATA_WIDTH-1:0]    din_a;
    output reg  [DATA_WIDTH-1:0]    dout_a;
    input  wire                     clk_a;


    // Memory array: 256 words of 32 bits
    reg [DATA_WIDTH-1:0] mem [0:(1 << ADDR_WIDTH)-1];

    // Synchronous Port A
     always @(posedge clk_a) begin
        if (we_a) begin
            mem[addr_a] <= din_a;
        end
        dout_a <= mem[addr_a];  // Read occurs after write (read-after-write OK)
    end

endmodule
(* blackbox *)
module sprf_256x32 (
    input we_a,
    input [7:0] addr_a,
    input [31:0] din_a,
    output reg [31:0] dout_a,
    input clk_a
);
endmodule
