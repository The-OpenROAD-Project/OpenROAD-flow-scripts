    bus(dout_a)   {
        bus_type : sprf_256x256_DATA;
        direction : output;
        max_capacitance : 0.500000;
        timing() {
            related_pin : "clk_a" ;
            timing_type : rising_edge;
            timing_sense : non_unate;
            cell_rise(sprf_256x256_mem_out_delay_template) {
                index_1 ("0.009, 0.227");
                index_2 ("0.005, 0.500");
                values ( \
                  "0.218, 0.218", \
                  "0.218, 0.218" \
                )
            }
            cell_fall(sprf_256x256_mem_out_delay_template) {
