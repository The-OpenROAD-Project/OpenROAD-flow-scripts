"""Pins the kepler-formal that build_openroad.sh installs.

ORFS is not a Bazel project: this module exists only to install
kepler-formal into tools/install/kepler-formal. See README.md.
"""

module(name = "orfs-kepler-formal")

# To bump kepler-formal, change this version.
bazel_dep(name = "kepler-formal", version = "1.0.0-20261105-6870bd1a")

# kepler-formal builds with a downloaded clang on x86-64 Linux. It
# registers that toolchain for its own builds only, a dev_dependency by
# design, so a module that depends on it registers it too, at the same
# version, as kepler-formal's .github/consumer-test does. Elsewhere the
# host compiler is used.
bazel_dep(name = "llvm", version = "0.8.26")

llvm_toolchains = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
llvm_toolchains.exec(
    arch = "x86_64",
    os = "linux",
)
llvm_toolchains.target(
    arch = "x86_64",
    os = "linux",
)
use_repo(llvm_toolchains, "llvm_toolchains")

register_toolchains("@llvm_toolchains//:all")
