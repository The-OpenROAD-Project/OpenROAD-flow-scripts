+def _split_whitespace(value):
+    """Split on any run of whitespace, dropping empties.
+
+    Starlark's split() requires an explicit separator and has no
+    whitespace-splitting form, so a config.mk list that is spread over
+    several backslash-continued lines cannot be counted with a single
+    split(" "): the continuations leave newlines and runs of spaces that
+    would be counted as empty entries.
+    """
+    for whitespace in ["\n", "\t", "\r"]:
+        value = value.replace(whitespace, " ")
+    return [word for word in value.split(" ") if word]
+
