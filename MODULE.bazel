"""ORFS bazel setup."""

module(
    name = "orfs",
    version = "0.0.1",
)

# --- Regular dependencies (propagated to downstream consumers) ---

bazel_dep(name = "rules_python", version = "2.0.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

# --- Dev dependencies (only honoured when @orfs is the root module) ---
#
# When @orfs is consumed as a non-root dep (e.g. by tools/OpenROAD), the
# downstream module brings its own openroad/qt-bazel/bazel-orfs/yosys-slang
# pins and orfs.default() configuration. Marking everything below as
# dev_dependency = True makes those declarations no-ops in that case, so
# our MODULE.bazel doesn't need to be patched at non-root consumption
# time.

# hermetic-llvm (BCR module "llvm") provides statically linked LLVM
# binaries and a zero-sysroot cc_toolchain: no host compiler, linker or
# /usr/include involved, so host glibc changes cannot break the build.
# Mirrors tools/OpenROAD/MODULE.bazel (its llvm dep is dev-only, so it
# does not propagate here).
bazel_dep(name = "llvm", version = "0.8.11", dev_dependency = True)

# The gnulib-based GNU tools (sed, gawk, m4, bison) vendor wrapper
# headers that must shadow libc headers, which breaks against
# hermetic-llvm's explicit libc -isystem entries (BCR #7642). Mirror
# tools/OpenROAD's fixed-version overrides (single_version_override is
# root-honored only); drop each when tools/OpenROAD drops its copy.
#
# sed is transitive (bazel-orfs -> abc -> readline -> ncurses -> sed);
# 4.9.bcr.5 carries the upstream fix (BCR #7915).
single_version_override(
    module_name = "sed",
    version = "4.9.bcr.5",
)

# gawk is transitive (abc -> ncurses -> gawk; yosys -> gawk);
# 5.3.2.bcr.7 carries the upstream fix (BCR #7989).
single_version_override(
    module_name = "gawk",
    version = "5.3.2.bcr.7",
)

# m4 is transitive (rules_bison/rules_flex -> m4).
single_version_override(
    module_name = "m4",
    version = "1.4.21.bcr.4",
)

# bison is transitive (rules_bison -> bison). 3.8.2.bcr.7 fixes lib/
# but src/ still picks up raw libc headers; the patch restores gnulib
# wrapper-header precedence via -I (to be proposed upstream as
# 3.8.2.bcr.8, then drop).
single_version_override(
    module_name = "bison",
    patch_strip = 1,
    patches = [
        "//patches/bison:0001-gnulib-wrapper-headers-use-I-not-isystem.patch",
    ],
    version = "3.8.2.bcr.7",
)

# openroad is normally consumed straight from the tools/OpenROAD
# submodule via local_path_override. While the E12 macro-placement
# experiment carries OpenROAD patches in //patches/openroad
# (local_path_override does not accept patches), it is fetched via
# git_override instead, pinned to the exact commit the submodule
# gitlink records so make (submodule) and bazel (fetched + patched)
# build the same base. Note that bazel builds the fetched source, not
# the live submodule tree, while this override is in place; revert to
# local_path_override when the patches land upstream.
#
# All five patches originate on the public bazel-orfs `macro-selector`
# branch (patches/0040-0043, 0045) and apply cleanly and in order at
# the pinned commit. src/mpl, src/gpl, src/par and src/odb/src are
# byte-identical between the pinned commit and OpenROAD 3ca581e38,
# which is the commit the archived swerv_wrapper measurements in
# flow/test/macro_e12/score_vs_flow_swerv.json were taken at -- that
# is what makes those numbers a valid reference here.
#
# patches/openroad/0001-mpl-fix-rerun-segfault.patch:
# HierRTLMP::run() ends with clear(), which destroys the physical
# hierarchy tree that was only ever built in the constructor, so a
# second rtl_macro_placer in one process handed a null tree to the
# clustering engine and crashed. Recreates the tree lazily. Required
# for generating many candidates in one process.
# OpenROAD issue #11277.
#
# patches/openroad/0002-mpl-add-random_seed.patch:
# adds `rtl_macro_placer -random_seed`, defaulting to the previously
# hard-coded 0 so stock behaviour is unchanged. Same seed reproduces
# the placement; different seeds explore different annealing
# trajectories. This is what turns the macro placer into a
# deterministic candidate generator instead of requiring CORE_AREA or
# cost-weight perturbation to obtain distinct placements.
# No upstream issue: a feature, to be proposed separately.
#
# patches/openroad/0003-mpl-keep-snapped-macros-inside-core.patch:
# the Snapper picked the track position closest to the pin centre,
# rounding up, which pushed top/right-edge macros past the core;
# place_macro then rejected the placer's own -write_macro_placement
# output with MPL-0034, so a selected placement could not be
# re-injected via MACRO_PLACEMENT_TCL. OpenROAD issue #11278.
#
# patches/openroad/0004-mpl-seed-std-cells-when-all-macros-fixed.patch:
# when every macro was fixed, run() skipped the whole pipeline
# including generateTemporaryStdCellsPlacement() and the macro soft
# blockages, so a re-injected placement diverged (~2% achieved
# period) from the run that generated it despite bit-identical macro
# geometry. OpenROAD issue #11279.
#
# patches/openroad/0005-gpl-thread-invariant-parallel-density-scatter.patch:
# BinGrid's density scatter was serial at any -threads. Parallelises
# it while accumulating into the bins' existing int64_t fields via
# std::atomic_ref with relaxed ordering: each addend is truncated to
# int64 before adding, so the sum is over a fixed multiset and is
# bit-identical at any thread count. Ships an mt_invariance
# integration test. OpenROAD PR #11262.
bazel_dep(name = "openroad", dev_dependency = True)
git_override(
    module_name = "openroad",
    commit = "4b704bb69321203e5bf5db74182bfae9e8721d1e",
    init_submodules = True,
    patch_strip = 1,
    patches = [
        "//patches/openroad:0001-mpl-fix-rerun-segfault.patch",
        "//patches/openroad:0002-mpl-add-random_seed.patch",
        "//patches/openroad:0003-mpl-keep-snapped-macros-inside-core.patch",
        "//patches/openroad:0004-mpl-seed-std-cells-when-all-macros-fixed.patch",
        "//patches/openroad:0005-gpl-thread-invariant-parallel-density-scatter.patch",
    ],
    remote = "https://github.com/The-OpenROAD-Project/OpenROAD.git",
)

bazel_dep(name = "qt-bazel", dev_dependency = True)
git_override(
    module_name = "qt-bazel",
    commit = "886104974c2fd72439f2c33b5deebf0fe4649df7",
    remote = "https://github.com/The-OpenROAD-Project/qt_bazel_prebuilts",
)

# Exception to the dev-only rule above: flow/BUILD has
# load("@bazel-orfs//:openroad.bzl", "orfs_pdk"), so @bazel-orfs must stay
# visible from @orfs even at non-root consumption; a dev-only bazel_dep
# suppresses that visibility. Only the git_override below (implicitly
# root-only) is dev-conditional — at non-root the consumer's own bazel-orfs
# satisfies this dep. When @orfs is root, dev deps are honoured anyway, so
# the resolved module graph is unchanged.
bazel_dep(name = "bazel-orfs", version = "0.0.1")

bazel_dep(name = "bazel-orfs-verilog", dev_dependency = True)

# Bumped past bazel-orfs 4254fc9 "synth: support OpenROAD-SYN engine
# (SYNTH_USE_SYN=1)". The previous pin predated that support, so every
# design whose config.mk sets SYNTH_USE_SYN=1 -- gcd and swerv_wrapper
# among them -- failed its bazel synth with `sv_elaborate ... error: no
# input files`. bazel-orfs empties VERILOG_FILES for the synth action
# because the yosys path reads canonicalized RTLIL instead and the
# sources are not among that action's inputs; OpenROAD-SYN elaborates the
# sources directly and has no canonicalize step, so it needs them.
#
# This is the last commit before bazel-orfs 9bc8c74 "migrate from local
# verilog submodule to rules_chisel", which deletes the verilog/ subtree
# that @bazel-orfs-verilog is built from below (strip_prefix = "verilog").
# Going further therefore means migrating ORFS to rules_chisel, which is
# its own change. Note that bazel-orfs's //fork facility lands only after
# that removal, so it is still unavailable here -- flow/test/macro_e12
# detects its absence and runs candidates serially.
BAZEL_ORFS_COMMIT = "ca4e9dd41e0f2e7ab3174535dab4fc7c680b1085"

BAZEL_ORFS_REMOTE = "https://github.com/The-OpenROAD-Project/bazel-orfs.git"

# To bump version, run: bazelisk run @bazel-orfs//:bump
# patches/bazel-orfs/0001-design-count-keep-modules-across-continued-lines.patch:
# orfs_design() sizes SYNTH_NUM_PARTITIONS from SYNTH_KEEP_MODULES using
# Starlark's split() with no separator, which is a Python-ism -- Starlark
# requires one. Any design setting both SYNTH_HIERARCHICAL=1 and
# SYNTH_KEEP_MODULES therefore fails at analysis with "split() missing 1
# required positional argument: sep". Splitting on runs of whitespace is
# what the count actually needs, because a config.mk list is spread over
# backslash-continued lines.
git_override(
    module_name = "bazel-orfs",
    commit = BAZEL_ORFS_COMMIT,
    patch_strip = 1,
    patches = [
        "//patches/bazel-orfs:0001-design-count-keep-modules-across-continued-lines.patch",
    ],
    remote = BAZEL_ORFS_REMOTE,
)

git_override(
    module_name = "bazel-orfs-verilog",
    commit = BAZEL_ORFS_COMMIT,
    remote = BAZEL_ORFS_REMOTE,
    strip_prefix = "verilog",
)

# yosys-slang is not on BCR. Pin to a commit on povik/yosys-slang master
# that has the upstream Bazel build (povik/yosys-slang#310) and the
# slang.so visibility fix (povik/yosys-slang#311). Submodules pull in
# vendored slang and fmt sources.
bazel_dep(name = "yosys-slang", dev_dependency = True)
git_override(
    module_name = "yosys-slang",
    commit = "7753ea70431d85929292b90c33b32f6dbdb3b048",
    init_submodules = True,
    remote = "https://github.com/povik/yosys-slang.git",
)

bazel_dep(name = "fakeram", dev_dependency = True)
git_override(
    module_name = "fakeram",
    commit = "6f62c655952b683cda679d80850cb557cc3c262e",
    patch_strip = 1,
    patches = [
        "//patches/fakeram:0001-Add-ORFS-ASAP7-backend.patch",
    ],
    remote = "https://github.com/The-OpenROAD-Project/FakeRAM2.0.git",
)

# --- Extensions ---

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)

# sv-lang (via tools/OpenROAD) pulls in rules_pycross, whose toolchain
# extension fails on Python 3.8 (transitively registered via or-tools ->
# pybind11_abseil, dropped from rules_python 2.0.0's MINOR_MAPPING).
# pycross.configure_environments is root-honored only, so the workaround
# must be mirrored here from tools/OpenROAD/MODULE.bazel.
bazel_dep(name = "rules_pycross", version = "0.8.1", dev_dependency = True)

pycross = use_extension(
    "@rules_pycross//pycross/extensions:pycross.bzl",
    "pycross",
    dev_dependency = True,
)
pycross.configure_environments(python_versions = ["3.13"])

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    ignore_root_user_error = True,
    python_version = "3.13",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "orfs-pip",
    python_version = "3.13",
    quiet = True,
    requirements_lock = "//flow:util/requirements_lock.txt",
)
use_repo(pip, "orfs-pip")

orfs = use_extension(
    "@bazel-orfs//:extension.bzl",
    "orfs_repositories",
    dev_dependency = True,
)
orfs.default(
    # Expose the yosys-slang plugin via YOSYS_PLUGIN_PATH so
    # SYNTH_HDL_FRONTEND=slang works for ibex, cva6, uart, etc.
    yosys_plugins = ["@yosys-slang//src/yosys_plugin:slang.so"],
)
use_repo(orfs, "config")
use_repo(orfs, "gnumake")
use_repo(orfs, "orfs_variable_metadata")

# Auto-generate orfs_flow() targets from config.mk files.
# See flow/README.md for usage.
orfs_designs = use_repo_rule("@bazel-orfs//private:designs.bzl", "orfs_designs")

orfs_designs(
    name = "orfs_designs",
    designs_dir = "//flow/designs:BUILD",
    platforms = [
        "asap7",
        "gf180",
        "ihp-sg13g2",
        "nangate45",
        "sky130hd",
        "sky130hs",
    ],
)
